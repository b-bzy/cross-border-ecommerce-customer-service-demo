# Default mode is local, deterministic, and network-free.
DEMO_ROUTER_MODE=offline
DEMO_COMMERCE_TRANSPORT=in_process
DEMO_CLAUDE_MODEL=claude-opus-5
DEMO_ACTION_TTL_SECONDS=300
DEMO_REQUEST_TIMEOUT_SECONDS=15

# Set only in a local ignored .env file or shell when using hybrid/live Claude reranking.
# ANTHROPIC_API_KEY=
